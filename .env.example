# Server
NODE_ENV=development
PORT=3000
HOST=localhost

# Data storage
DATA_DIR=.agent-team

# Logging
LOG_LEVEL=info

# LLM Configuration
# Supports any OpenAI-compatible API (OpenAI, MiniMax, Deepseek, Moonshot, Ollama, etc.)
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://api.minimaxi.com/v1
LLM_API_KEY=your-coding-plan-key-here
LLM_MODEL=MiniMax-M2.5
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_MS=60000
LLM_MAX_RETRIES=3
